# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=appwrite.example.com

SERVICE_USER=1000
SERVICE_GROUP=1000

DB_CREATE_DATABASE_NAME=appwrite
DB_USER_NAME=appwrite
DB_USER_PASS=replace-with-a-random-password
DB_ADMIN_PASS=replace-with-a-random-password

APP_ORG_NAME=Appwrite

ENCRYPTION_KEY=replace-with-a-random-32-byte-hex-string
SECURE_SECRET=replace-with-a-random-32-byte-hex-string

EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USE_TLS=true
EMAIL_SERVER_USE_SSL=false
EMAIL_SERVER_LOGIN_NAME=
EMAIL_SERVER_LOGIN_PASS=
